APP_NAME=Adisyon
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Reverse proxy IP/CIDR listesi (virgülle ayrılmış). Yalnızca gerçekten kullandığınız proxyleri yazın.
# Örn: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
WAITER_API_TOKEN_TTL_MINUTES=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
ADISYON_COMPANION_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adisyon
DB_USERNAME=adisyon
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Flutter realtime WebSocket / Laravel Reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=*
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADISYON_OFFLINE_MODE=false
ADISYON_BASE_URL=https://adisyon.example.com
ADISYON_SYNC_PULL_URL="${ADISYON_BASE_URL}/api/v1/sync/pull"
ADISYON_SYNC_PUSH_URL="${ADISYON_BASE_URL}/api/v1/sync/push"
ADISYON_DEVICE_API_KEY=

ALLOW_UNSIGNED_LOCAL_WEBHOOKS=false
TRENDYOL_GO_WEBHOOK_SECRET=
YEMEKSEPETI_WEBHOOK_SECRET=

# PEM değerlerini tek satırda, satır sonlarını \n olarak girin.
UPDATE_SIGNING_PRIVATE_KEY=
UPDATE_SIGNING_PUBLIC_KEY=

# Sadece açıkça veritabanı seed işlemi çalıştırıldığında kullanılır.
SEED_ADMIN_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_WAITER_PIN=
SEED_CHAIN_PASSWORD=
